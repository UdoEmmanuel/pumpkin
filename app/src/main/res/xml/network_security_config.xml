<?xml version="1.0" encoding="utf-8"?>
<!-- PRD 9: standard TLS in transit is assumed sufficient for this school project
     (E2E encryption is a stretch goal, not built in Phase 1). The app talks to
     a real https:// deployment (see ServerConfig.kt), so cleartext is
     forbidden everywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
