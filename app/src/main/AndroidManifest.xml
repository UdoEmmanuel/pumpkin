<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for Firestore/FCM connectivity -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Biometric lock (PRD 4.2) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- In-app "Update app": launches the system package installer with a
         downloaded APK. The user still has to confirm the install and grant
         "install unknown apps" for Pumpkin once, the same as sideloading any
         APK manually — this permission only lets the app START that flow. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Voice notes: press-and-hold record in the chat input row. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".PumpkinApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_display_label"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pumpkin"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          PRD 4.1: hidden entry / no visible launcher icon for the real app.
          Implementation choice: the launcher activity IS the decoy calculator
          (label/icon disguised as a plain calculator). There is no separate
          "Pumpkin" icon anywhere in the launcher — entering the secret code
          inside the calculator is what reveals the real chat UI.

          Alternative considered (per PRD): ship this same activity behind a
          disabled <activity-alias> and toggle it on via a dialer-code
          BroadcastReceiver. Rejected for the MVP because it requires ADB or a
          fragile receiver to ever open the app the first time, which is a
          poor fit for a live demo. Known limitation either way: the app
          still shows up in Settings > Apps by package name, and briefly in
          Recents unless excluded — see MainActivity.
        -->
        <activity
            android:name=".ui.calculator.MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_display_label"
            android:theme="@style/Theme.Pumpkin"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging: silent/data-only push, no notification tray entry (PRD 4.3) -->
        <service
            android:name=".data.remote.PumpkinMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Grants the system package installer a content:// Uri for the
             downloaded update APK (a file:// Uri isn't accepted for this
             across app boundaries on API 24+). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
