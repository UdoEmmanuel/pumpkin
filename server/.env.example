# Copy to .env and fill in. Never commit the real .env.

PORT=4000

# MongoDB Atlas connection string (free M0 cluster). Get this from
# Atlas -> Database -> Connect -> Drivers, after creating a cluster and a
# database user. Looks like:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pumpkin?retryWrites=true&w=majority
MONGODB_URI=

# Path to the Firebase service account JSON key file, downloaded from
# Firebase console -> Project Settings -> Service Accounts -> Generate new
# private key. Used ONLY to (a) verify the ID tokens the Android app sends
# with each request, and (b) read (never write) the existing Firestore
# `users` collection to look partners up by email. Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# In-app "Update app" feature: proxies GitHub Releases so the Android app
# never needs its own GitHub credential. GITHUB_REPO is "owner/repo" (e.g.
# UdoEmmanuel/pumpkin). GITHUB_TOKEN is a GitHub Personal Access Token with
# read-only access to this one repo's contents — a fine-grained PAT scoped
# to just "Pumpkin" -> Contents: Read-only is enough; classic PATs need the
# "repo" scope for a private repo. Never commit the real token. If either is
# unset, /api/app/latest and /api/app/download return 503 (feature disabled,
# rest of the app unaffected).
GITHUB_REPO=
GITHUB_TOKEN=
